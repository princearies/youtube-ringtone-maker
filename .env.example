# ─────────────────────────────────────────────────────────────
# ENGINE  (services/engine) — copy to .env or export in the shell
# ─────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8788

# Shared secret. The Worker sends it as `x-engine-token`.
# REQUIRED as soon as HOST is not 127.0.0.1.
ENGINE_TOKEN=change-me-long-random

# Binaries (absolute path if not on PATH)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# YTDLP_PATH=C:\tools\yt-dlp.exe

# Limits
FILE_TTL_MS=900000
MAX_SOURCE_DURATION_SEC=900
MAX_CLIP_SEC=60
MAX_M4R_SEC=40
MAX_PARALLEL=2
DOWNLOAD_TIMEOUT_MS=180000

# yt-dlp tuning (needed on datacenter IPs that YouTube challenges)
# YTDLP_PROXY=http://user:pass@host:port
# YTDLP_COOKIES=/data/cookies.txt
# YTDLP_EXTRA_ARGS=--extractor-args youtube:player_client=android

# Loudness-normalise every ringtone (I=-16 LUFS). Costs a little CPU.
NORMALIZE=0

# Local dev only: accept a local file path / file:// URL as "source"
DEV_ALLOW_LOCAL_FILES=1
